<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" xmlns:presentation="urn:oasis:names:tc:opendocument:xmlns:presentation:1.0" office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.presentation">
<office:font-face-decls>
<style:font-face style:name="Liberation Sans" svg:font-family="&apos;Liberation Sans&apos;" style:font-family-generic="swiss" style:font-pitch="variable"/>
</office:font-face-decls>
<office:styles>
<style:default-style style:family="graphic">
<style:graphic-properties draw:stroke="none" draw:fill="none" draw:auto-grow-height="false" draw:textarea-vertical-align="top" fo:padding-top="0.05in" fo:padding-bottom="0.05in" fo:padding-left="0.1in" fo:padding-right="0.1in"/>
<style:paragraph-properties fo:margin-top="0in" fo:margin-bottom="0.06in" fo:line-height="100%"/>
<style:text-properties style:font-name="Liberation Sans" fo:font-size="18pt" fo:color="#1f2937" fo:language="it" fo:country="IT"/>
</style:default-style>
</office:styles>
<office:automatic-styles>
<style:page-layout style:name="PM1"><style:page-layout-properties fo:margin-top="0in" fo:margin-bottom="0in" fo:margin-left="0in" fo:margin-right="0in" fo:page-width="10in" fo:page-height="5.625in" style:print-orientation="landscape"/></style:page-layout>
<style:style style:name="dp1" style:family="drawing-page"><style:drawing-page-properties draw:fill="solid" draw:fill-color="#ffffff" presentation:background-visible="true" presentation:background-objects-visible="true"/></style:style>
<style:style style:name="frame" style:family="graphic"><style:graphic-properties draw:stroke="none" draw:fill="none"/></style:style>

<style:style style:name="Ptitle" style:family="paragraph"><style:text-properties fo:font-size="32pt" fo:font-weight="bold" fo:color="#1e3a8a"/></style:style>
<style:style style:name="Psub" style:family="paragraph"><style:text-properties fo:font-size="18pt" fo:color="#475569"/></style:style>
<style:style style:name="Pbody" style:family="paragraph"><style:paragraph-properties fo:margin-bottom="0.1in"/><style:text-properties fo:font-size="18pt"/></style:style>
<style:style style:name="Psmall" style:family="paragraph"><style:text-properties fo:font-size="14pt"/></style:style>
<style:style style:name="Pcenter" style:family="paragraph"><style:paragraph-properties fo:text-align="center" fo:margin-bottom="0in"/><style:text-properties fo:font-size="16pt" fo:font-weight="bold" fo:color="#ffffff"/></style:style>
<style:style style:name="Pbig" style:family="paragraph"><style:paragraph-properties fo:text-align="center" fo:margin-bottom="0in"/><style:text-properties fo:font-size="40pt" fo:font-weight="bold" fo:color="#ffffff"/></style:style>
<style:style style:name="Pcell" style:family="paragraph"><style:paragraph-properties fo:margin-bottom="0in"/><style:text-properties fo:font-size="14pt"/></style:style>
<style:style style:name="Phead" style:family="paragraph"><style:paragraph-properties fo:margin-bottom="0in"/><style:text-properties fo:font-size="14pt" fo:font-weight="bold" fo:color="#ffffff"/></style:style>
<style:style style:name="Tb" style:family="text"><style:text-properties fo:font-weight="bold"/></style:style>
<style:style style:name="co1" style:family="table-column"><style:table-column-properties style:column-width="1.4in"/></style:style>
<style:style style:name="co2" style:family="table-column"><style:table-column-properties style:column-width="4.6in"/></style:style>
<style:style style:name="co3" style:family="table-column"><style:table-column-properties style:column-width="2.8in"/></style:style>
<style:style style:name="ro1" style:family="table-row"><style:table-row-properties style:row-height="0.5in"/></style:style>
<style:style style:name="ce1" style:family="table-cell"><style:graphic-properties draw:fill="solid" draw:fill-color="#1e3a8a"/><style:paragraph-properties fo:border="0.01in solid #94a3b8"/></style:style>
<style:style style:name="ce2" style:family="table-cell"><style:graphic-properties draw:fill="solid" draw:fill-color="#ffffff"/><style:paragraph-properties fo:border="0.01in solid #94a3b8"/></style:style>
<style:style style:name="ce3" style:family="table-cell"><style:graphic-properties draw:fill="solid" draw:fill-color="#eff6ff"/><style:paragraph-properties fo:border="0.01in solid #94a3b8"/></style:style>
</office:automatic-styles>
<office:master-styles><style:master-page style:name="Default" style:page-layout-name="PM1" draw:style-name="dp1"/></office:master-styles>
<office:body><office:presentation>
<draw:page draw:name="page1" draw:style-name="dp1" draw:master-page-name="Default"><draw:frame draw:style-name="frame" svg:x="0.6in" svg:y="0.4in" svg:width="8.8in" svg:height="0.8in"><draw:text-box><text:p text:style-name="Ptitle">Ordine del giorno</text:p></draw:text-box></draw:frame><draw:frame draw:style-name="frame" svg:x="0.6in" svg:y="1.4in" svg:width="8.8in" svg:height="2.5in"><table:table><table:table-column table:style-name="co1"/><table:table-column table:style-name="co2"/><table:table-column table:style-name="co3"/><table:table-row table:style-name="ro1"><table:table-cell table:style-name="ce1"><text:p text:style-name="Phead">Ora</text:p></table:table-cell><table:table-cell table:style-name="ce1"><text:p text:style-name="Phead">Argomento</text:p></table:table-cell><table:table-cell table:style-name="ce1"><text:p text:style-name="Phead">Relatore</text:p></table:table-cell></table:table-row><table:table-row table:style-name="ro1"><table:table-cell table:style-name="ce2"><text:p text:style-name="Pcell">10:00</text:p></table:table-cell><table:table-cell table:style-name="ce2"><text:p text:style-name="Pcell">Apertura e approvazione del verbale</text:p></table:table-cell><table:table-cell table:style-name="ce2"><text:p text:style-name="Pcell">Giulia Bianchi</text:p></table:table-cell></table:table-row><table:table-row table:style-name="ro1"><table:table-cell table:style-name="ce3"><text:p text:style-name="Pcell">10:15</text:p></table:table-cell><table:table-cell table:style-name="ce3"><text:p text:style-name="Pcell">Stato di avanzamento dei progetti</text:p></table:table-cell><table:table-cell table:style-name="ce3"><text:p text:style-name="Pcell">Marco Rossi</text:p></table:table-cell></table:table-row><table:table-row table:style-name="ro1"><table:table-cell table:style-name="ce2"><text:p text:style-name="Pcell">10:45</text:p></table:table-cell><table:table-cell table:style-name="ce2"><text:p text:style-name="Pcell">Budget del quarto trimestre</text:p></table:table-cell><table:table-cell table:style-name="ce2"><text:p text:style-name="Pcell">Elena Conti</text:p></table:table-cell></table:table-row><table:table-row table:style-name="ro1"><table:table-cell table:style-name="ce3"><text:p text:style-name="Pcell">11:15</text:p></table:table-cell><table:table-cell table:style-name="ce3"><text:p text:style-name="Pcell">Varie ed eventuali</text:p></table:table-cell><table:table-cell table:style-name="ce3"><text:p text:style-name="Pcell">Luca Ferrari</text:p></table:table-cell></table:table-row></table:table></draw:frame><draw:frame draw:style-name="frame" svg:x="0.6in" svg:y="4.3in" svg:width="8.8in" svg:height="0.6in"><draw:text-box><text:p text:style-name="Psmall">Sala riunioni della sede di Milano e collegamento remoto.</text:p></draw:text-box></draw:frame></draw:page>
<draw:page draw:name="page2" draw:style-name="dp1" draw:master-page-name="Default"><draw:frame draw:style-name="frame" svg:x="0.6in" svg:y="0.4in" svg:width="8.8in" svg:height="0.8in"><draw:text-box><text:p text:style-name="Ptitle">Decisioni da prendere</text:p></draw:text-box></draw:frame><draw:frame draw:style-name="frame" svg:x="0.6in" svg:y="1.4in" svg:width="8.8in" svg:height="3.6in"><draw:text-box><text:p text:style-name="Pbody"><text:span text:style-name="Tb">Rilascio:</text:span> confermare la data del 18 novembre 2026.</text:p><text:p text:style-name="Pbody"><text:span text:style-name="Tb">Fornitore:</text:span> scegliere tra adattatore provvisorio e attesa delle nuove interfacce.</text:p><text:p text:style-name="Pbody"><text:span text:style-name="Tb">Budget:</text:span> approvare lo spostamento di 12.000 euro sulla formazione.</text:p></draw:text-box></draw:frame></draw:page>
</office:presentation></office:body>
</office:document>
