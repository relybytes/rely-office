<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" xmlns:presentation="urn:oasis:names:tc:opendocument:xmlns:presentation:1.0" office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.presentation">
<office:font-face-decls>
<style:font-face style:name="Liberation Sans" svg:font-family="&apos;Liberation Sans&apos;" style:font-family-generic="swiss" style:font-pitch="variable"/>
</office:font-face-decls>
<office:styles>
<style:default-style style:family="graphic">
<style:graphic-properties draw:stroke="none" draw:fill="none" draw:auto-grow-height="false" draw:textarea-vertical-align="top" fo:padding-top="0.05in" fo:padding-bottom="0.05in" fo:padding-left="0.1in" fo:padding-right="0.1in"/>
<style:paragraph-properties fo:margin-top="0in" fo:margin-bottom="0.06in" fo:line-height="100%"/>
<style:text-properties style:font-name="Liberation Sans" fo:font-size="18pt" fo:color="#1f2937" fo:language="it" fo:country="IT"/>
</style:default-style>
</office:styles>
<office:automatic-styles>
<style:page-layout style:name="PM1"><style:page-layout-properties fo:margin-top="0in" fo:margin-bottom="0in" fo:margin-left="0in" fo:margin-right="0in" fo:page-width="10in" fo:page-height="5.625in" style:print-orientation="landscape"/></style:page-layout>
<style:style style:name="dp1" style:family="drawing-page"><style:drawing-page-properties draw:fill="solid" draw:fill-color="#ffffff" presentation:background-visible="true" presentation:background-objects-visible="true"/></style:style>
<style:style style:name="frame" style:family="graphic"><style:graphic-properties draw:stroke="none" draw:fill="none"/></style:style>
<style:style style:name="band" style:family="graphic"><style:graphic-properties draw:fill="solid" draw:fill-color="#1e3a8a" draw:stroke="none" draw:textarea-vertical-align="middle" draw:textarea-horizontal-align="center"/></style:style>
<style:style style:name="badge" style:family="graphic"><style:graphic-properties draw:fill="solid" draw:fill-color="#2563eb" draw:stroke="none" draw:textarea-vertical-align="middle" draw:textarea-horizontal-align="center"/></style:style>
<style:style style:name="amber" style:family="graphic"><style:graphic-properties draw:fill="solid" draw:fill-color="#f59e0b" draw:stroke="none" draw:textarea-vertical-align="middle" draw:textarea-horizontal-align="center"/></style:style>
<style:style style:name="green" style:family="graphic"><style:graphic-properties draw:fill="solid" draw:fill-color="#10b981" draw:stroke="none" draw:textarea-vertical-align="middle" draw:textarea-horizontal-align="center"/></style:style>
<style:style style:name="Ptitle" style:family="paragraph"><style:text-properties fo:font-size="32pt" fo:font-weight="bold" fo:color="#1e3a8a"/></style:style>
<style:style style:name="Psub" style:family="paragraph"><style:text-properties fo:font-size="18pt" fo:color="#475569"/></style:style>
<style:style style:name="Pbody" style:family="paragraph"><style:paragraph-properties fo:margin-bottom="0.1in"/><style:text-properties fo:font-size="18pt"/></style:style>
<style:style style:name="Psmall" style:family="paragraph"><style:text-properties fo:font-size="14pt"/></style:style>
<style:style style:name="Pcenter" style:family="paragraph"><style:paragraph-properties fo:text-align="center" fo:margin-bottom="0in"/><style:text-properties fo:font-size="16pt" fo:font-weight="bold" fo:color="#ffffff"/></style:style>
<style:style style:name="Pbig" style:family="paragraph"><style:paragraph-properties fo:text-align="center" fo:margin-bottom="0in"/><style:text-properties fo:font-size="40pt" fo:font-weight="bold" fo:color="#ffffff"/></style:style>
<style:style style:name="Pcell" style:family="paragraph"><style:paragraph-properties fo:margin-bottom="0in"/><style:text-properties fo:font-size="14pt"/></style:style>
<style:style style:name="Phead" style:family="paragraph"><style:paragraph-properties fo:margin-bottom="0in"/><style:text-properties fo:font-size="14pt" fo:font-weight="bold" fo:color="#ffffff"/></style:style>
<style:style style:name="Tb" style:family="text"><style:text-properties fo:font-weight="bold"/></style:style>

</office:automatic-styles>
<office:master-styles><style:master-page style:name="Default" style:page-layout-name="PM1" draw:style-name="dp1"/></office:master-styles>
<office:body><office:presentation>
<draw:page draw:name="page1" draw:style-name="dp1" draw:master-page-name="Default"><draw:frame draw:style-name="frame" svg:x="0.6in" svg:y="1.4in" svg:width="8.8in" svg:height="1.0in"><draw:text-box><text:p text:style-name="Ptitle">Risultati del terzo trimestre 2026</text:p></draw:text-box></draw:frame><draw:frame draw:style-name="frame" svg:x="0.6in" svg:y="2.4in" svg:width="8.8in" svg:height="0.6in"><draw:text-box><text:p text:style-name="Psub">Comitato di direzione, 21 ottobre 2026</text:p></draw:text-box></draw:frame><draw:custom-shape draw:style-name="band" svg:x="0in" svg:y="4.9in" svg:width="10in" svg:height="0.725in"><draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:type="rectangle"/></draw:custom-shape></draw:page>
<draw:page draw:name="page2" draw:style-name="dp1" draw:master-page-name="Default"><draw:frame draw:style-name="frame" svg:x="0.6in" svg:y="0.4in" svg:width="8.8in" svg:height="0.8in"><draw:text-box><text:p text:style-name="Ptitle">Ricavi e margini</text:p></draw:text-box></draw:frame><draw:frame draw:style-name="frame" svg:x="0.6in" svg:y="1.4in" svg:width="5.4in" svg:height="3.6in"><draw:text-box><text:p text:style-name="Pbody">Ricavi in crescita del 18% sul trimestre precedente.</text:p><text:p text:style-name="Pbody">Tre nuovi clienti nel settore manifatturiero.</text:p><text:p text:style-name="Pbody">Margine operativo stabile al 38%.</text:p><text:p text:style-name="Pbody">Costi del personale in linea con il budget.</text:p></draw:text-box></draw:frame><draw:custom-shape draw:style-name="badge" svg:x="6.5in" svg:y="1.5in" svg:width="2.8in" svg:height="1.3in"><text:p text:style-name="Pbig">+18%</text:p><draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:type="round-rectangle"/></draw:custom-shape><draw:custom-shape draw:style-name="amber" svg:x="6.6in" svg:y="3.2in" svg:width="1.2in" svg:height="1.2in"><draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:type="ellipse"/></draw:custom-shape><draw:custom-shape draw:style-name="green" svg:x="8.0in" svg:y="3.2in" svg:width="1.2in" svg:height="1.2in"><draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:type="ellipse"/></draw:custom-shape></draw:page>
<draw:page draw:name="page3" draw:style-name="dp1" draw:master-page-name="Default"><draw:frame draw:style-name="frame" svg:x="0.6in" svg:y="0.4in" svg:width="8.8in" svg:height="0.8in"><draw:text-box><text:p text:style-name="Ptitle">Prossimi passi</text:p></draw:text-box></draw:frame><draw:frame draw:style-name="frame" svg:x="0.6in" svg:y="1.4in" svg:width="8.8in" svg:height="3.6in"><draw:text-box><text:p text:style-name="Pbody">1. Chiudere il collaudo del modulo di fatturazione entro novembre.</text:p><text:p text:style-name="Pbody">2. Avviare la campagna commerciale per il nuovo listino.</text:p><text:p text:style-name="Pbody">3. Presentare il piano 2027 al consiglio di amministrazione.</text:p><text:p text:style-name="Psmall">Le date sono indicative e saranno confermate nella prossima riunione.</text:p></draw:text-box></draw:frame></draw:page>
</office:presentation></office:body>
</office:document>
