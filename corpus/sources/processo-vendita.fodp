<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" xmlns:presentation="urn:oasis:names:tc:opendocument:xmlns:presentation:1.0" office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.presentation">
<office:font-face-decls>
<style:font-face style:name="Liberation Sans" svg:font-family="&apos;Liberation Sans&apos;" style:font-family-generic="swiss" style:font-pitch="variable"/>
</office:font-face-decls>
<office:styles>
<style:default-style style:family="graphic">
<style:graphic-properties draw:stroke="none" draw:fill="none" draw:auto-grow-height="false" draw:textarea-vertical-align="top" fo:padding-top="0.05in" fo:padding-bottom="0.05in" fo:padding-left="0.1in" fo:padding-right="0.1in"/>
<style:paragraph-properties fo:margin-top="0in" fo:margin-bottom="0.06in" fo:line-height="100%"/>
<style:text-properties style:font-name="Liberation Sans" fo:font-size="18pt" fo:color="#1f2937" fo:language="it" fo:country="IT"/>
</style:default-style>
</office:styles>
<office:automatic-styles>
<style:page-layout style:name="PM1"><style:page-layout-properties fo:margin-top="0in" fo:margin-bottom="0in" fo:margin-left="0in" fo:margin-right="0in" fo:page-width="10in" fo:page-height="5.625in" style:print-orientation="landscape"/></style:page-layout>
<style:style style:name="dp1" style:family="drawing-page"><style:drawing-page-properties draw:fill="solid" draw:fill-color="#ffffff" presentation:background-visible="true" presentation:background-objects-visible="true"/></style:style>
<style:style style:name="frame" style:family="graphic"><style:graphic-properties draw:stroke="none" draw:fill="none"/></style:style>
<style:style style:name="step" style:family="graphic"><style:graphic-properties draw:fill="solid" draw:fill-color="#2563eb" draw:stroke="none" draw:textarea-vertical-align="middle" draw:textarea-horizontal-align="center"/></style:style>
<style:style style:name="stepdark" style:family="graphic"><style:graphic-properties draw:fill="solid" draw:fill-color="#1e3a8a" draw:stroke="none" draw:textarea-vertical-align="middle" draw:textarea-horizontal-align="center"/></style:style>
<style:style style:name="arrow" style:family="graphic"><style:graphic-properties draw:fill="solid" draw:fill-color="#94a3b8" draw:stroke="none" draw:textarea-vertical-align="middle" draw:textarea-horizontal-align="center"/></style:style>
<style:style style:name="client" style:family="graphic"><style:graphic-properties draw:fill="solid" draw:fill-color="#f59e0b" draw:stroke="none" draw:textarea-vertical-align="middle" draw:textarea-horizontal-align="center"/></style:style>
<style:style style:name="outline" style:family="graphic"><style:graphic-properties draw:fill="solid" draw:fill-color="#ffffff" draw:stroke="solid" svg:stroke-color="#1e3a8a" svg:stroke-width="0.02in" draw:textarea-vertical-align="middle" draw:textarea-horizontal-align="center"/></style:style>
<style:style style:name="Ptitle" style:family="paragraph"><style:text-properties fo:font-size="32pt" fo:font-weight="bold" fo:color="#1e3a8a"/></style:style>
<style:style style:name="Psub" style:family="paragraph"><style:text-properties fo:font-size="18pt" fo:color="#475569"/></style:style>
<style:style style:name="Pbody" style:family="paragraph"><style:paragraph-properties fo:margin-bottom="0.1in"/><style:text-properties fo:font-size="18pt"/></style:style>
<style:style style:name="Psmall" style:family="paragraph"><style:text-properties fo:font-size="14pt"/></style:style>
<style:style style:name="Pcenter" style:family="paragraph"><style:paragraph-properties fo:text-align="center" fo:margin-bottom="0in"/><style:text-properties fo:font-size="16pt" fo:font-weight="bold" fo:color="#ffffff"/></style:style>
<style:style style:name="Pbig" style:family="paragraph"><style:paragraph-properties fo:text-align="center" fo:margin-bottom="0in"/><style:text-properties fo:font-size="40pt" fo:font-weight="bold" fo:color="#ffffff"/></style:style>
<style:style style:name="Pcell" style:family="paragraph"><style:paragraph-properties fo:margin-bottom="0in"/><style:text-properties fo:font-size="14pt"/></style:style>
<style:style style:name="Phead" style:family="paragraph"><style:paragraph-properties fo:margin-bottom="0in"/><style:text-properties fo:font-size="14pt" fo:font-weight="bold" fo:color="#ffffff"/></style:style>
<style:style style:name="Tb" style:family="text"><style:text-properties fo:font-weight="bold"/></style:style>

</office:automatic-styles>
<office:master-styles><style:master-page style:name="Default" style:page-layout-name="PM1" draw:style-name="dp1"/></office:master-styles>
<office:body><office:presentation>
<draw:page draw:name="page1" draw:style-name="dp1" draw:master-page-name="Default"><draw:frame draw:style-name="frame" svg:x="0.6in" svg:y="0.4in" svg:width="8.8in" svg:height="0.8in"><draw:text-box><text:p text:style-name="Ptitle">Il processo di vendita</text:p></draw:text-box></draw:frame><draw:custom-shape draw:style-name="step" svg:x="0.4in" svg:y="1.8in" svg:width="1.7in" svg:height="1.0in"><text:p text:style-name="Pcenter">Contatto</text:p><draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:type="round-rectangle"/></draw:custom-shape><draw:custom-shape draw:style-name="arrow" svg:x="2.18in" svg:y="2.05in" svg:width="0.55in" svg:height="0.5in"><draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:type="right-arrow"/></draw:custom-shape><draw:custom-shape draw:style-name="step" svg:x="2.8in" svg:y="1.8in" svg:width="1.7in" svg:height="1.0in"><text:p text:style-name="Pcenter">Analisi</text:p><draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:type="round-rectangle"/></draw:custom-shape><draw:custom-shape draw:style-name="arrow" svg:x="4.58in" svg:y="2.05in" svg:width="0.55in" svg:height="0.5in"><draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:type="right-arrow"/></draw:custom-shape><draw:custom-shape draw:style-name="step" svg:x="5.2in" svg:y="1.8in" svg:width="1.7in" svg:height="1.0in"><text:p text:style-name="Pcenter">Offerta</text:p><draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:type="round-rectangle"/></draw:custom-shape><draw:custom-shape draw:style-name="arrow" svg:x="6.98in" svg:y="2.05in" svg:width="0.55in" svg:height="0.5in"><draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:type="right-arrow"/></draw:custom-shape><draw:custom-shape draw:style-name="stepdark" svg:x="7.6in" svg:y="1.8in" svg:width="1.7in" svg:height="1.0in"><text:p text:style-name="Pcenter">Contratto</text:p><draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:type="round-rectangle"/></draw:custom-shape><draw:custom-shape draw:style-name="client" svg:x="3.9in" svg:y="3.5in" svg:width="2.2in" svg:height="1.2in"><text:p text:style-name="Pcenter">Cliente</text:p><draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:type="ellipse"/></draw:custom-shape><draw:custom-shape draw:style-name="outline" svg:x="0.4in" svg:y="3.6in" svg:width="2.9in" svg:height="1.0in"><text:p text:style-name="Psmall">Tempo medio: 21 giorni</text:p><draw:enhanced-geometry svg:viewBox="0 0 21600 21600" draw:type="rectangle"/></draw:custom-shape></draw:page>
</office:presentation></office:body>
</office:document>
