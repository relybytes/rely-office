{
  "name": "@relybytes/rely-office-react",
  "version": "0.8.0",
  "description": "Office documents in the browser, for the frontend: docx, doc, odt, Markdown, HTML, pptx, ppt, odp, xlsx, xls, ods, csv and plain text read and written through WebAssembly, React editor components for documents, spreadsheets, slides and text, and real-time collaboration over Yjs.",
  "license": "MPL-2.0",
  "author": "RelyBytes Consulting (https://relybytes.com)",
  "homepage": "https://github.com/relybytes/rely-office#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/relybytes/rely-office.git",
    "directory": "packages/rely-office-react"
  },
  "bugs": {
    "url": "https://github.com/relybytes/rely-office/issues"
  },
  "keywords": [
    "docx",
    "xlsx",
    "pptx",
    "office",
    "react",
    "editor",
    "tiptap",
    "prosemirror",
    "spreadsheet",
    "slides",
    "webassembly"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "runtime": ["./dist/runtime/index.d.ts"],
      "collab": ["./dist/collab/index.d.ts"],
      "collab-editor": ["./dist/collab/document-extensions.d.ts"]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./collab": {
      "types": "./dist/collab/index.d.ts",
      "default": "./dist/collab/index.js"
    },
    "./collab-editor": {
      "types": "./dist/collab/document-extensions.d.ts",
      "default": "./dist/collab/document-extensions.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "wasm/*.js",
    "wasm/*.d.ts",
    "wasm/*.wasm",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "sync-model": "node scripts/sync-model.mjs",
    "build": "npm run sync-model && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "npm run sync-model && tsc -p tsconfig.json --noEmit",
    "test": "npm run sync-model && vitest run",
    "smoke": "node test/smoke-dist.mjs",
    "demo": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts"
  },
  "peerDependencies": {
    "@tiptap/core": "^3.0.0",
    "@tiptap/extension-collaboration": "^3.0.0",
    "@tiptap/extension-collaboration-caret": "^3.0.0",
    "@tiptap/extension-image": "^3.0.0",
    "@tiptap/extension-table": "^3.0.0",
    "@tiptap/pm": "^3.0.0",
    "@tiptap/react": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "@tiptap/y-tiptap": "^3.0.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "@tiptap/core": { "optional": true },
    "@tiptap/extension-collaboration": { "optional": true },
    "@tiptap/extension-collaboration-caret": { "optional": true },
    "@tiptap/extension-image": { "optional": true },
    "@tiptap/extension-table": { "optional": true },
    "@tiptap/pm": { "optional": true },
    "@tiptap/react": { "optional": true },
    "@tiptap/starter-kit": { "optional": true },
    "@tiptap/y-tiptap": { "optional": true },
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-collaboration": "3.32.0",
    "@tiptap/extension-collaboration-caret": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@tiptap/y-tiptap": "3.0.11",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.5.2",
    "jsdom": "^27.4.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "lib0": "^0.2.119",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  }
}
