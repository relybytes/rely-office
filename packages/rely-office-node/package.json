{
  "name": "@relybytes/rely-office",
  "version": "0.12.0",
  "description": "The Office engine for AI products, on the backend: Word, Excel, PowerPoint and OpenDocument files read in Node through WebAssembly as text, tables and a document tree a model can use, docx, xlsx and pptx written back from what it produces, and PDF and PNG previews, with no office suite. The editors are @relybytes/rely-office-react.",
  "license": "Apache-2.0",
  "author": "RelyBytes S.r.l. (https://relybytes.com)",
  "homepage": "https://github.com/relybytes/rely-office#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/relybytes/rely-office.git",
    "directory": "packages/rely-office-node"
  },
  "bugs": {
    "url": "https://github.com/relybytes/rely-office/issues"
  },
  "keywords": [
    "docx",
    "xlsx",
    "pptx",
    "office",
    "text-extraction",
    "webassembly",
    "pdf",
    "typst",
    "spreadsheet",
    "formulas",
    "xlsx-writer",
    "docx-writer",
    "ai",
    "llm",
    "ai-agents",
    "rag"
  ],
  "type": "commonjs",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "model.d.ts",
    "wasm/*.js",
    "wasm/*.d.ts",
    "wasm/*.wasm",
    "fonts/*.ttf",
    "fonts/OFL-*.txt",
    "fonts/LICENSE-*.txt",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test/smoke.cjs"
  }
}
