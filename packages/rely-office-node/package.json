{
  "name": "@relybytes/rely-office",
  "version": "0.10.1",
  "description": "Office documents in Node through WebAssembly, for the backend: format detection, text for search, sheet tables, the document tree, PDF and PNG rendering through Typst, docx and pptx writing and an editable spreadsheet with formulas. The browser and the editor components are @relybytes/rely-office-react.",
  "license": "MPL-2.0",
  "author": "RelyBytes S.r.l. (https://relybytes.com)",
  "homepage": "https://github.com/relybytes/rely-office#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/relybytes/rely-office.git",
    "directory": "packages/rely-office-node"
  },
  "bugs": {
    "url": "https://github.com/relybytes/rely-office/issues"
  },
  "keywords": [
    "docx",
    "xlsx",
    "pptx",
    "office",
    "text-extraction",
    "webassembly",
    "pdf",
    "typst",
    "spreadsheet",
    "formulas",
    "xlsx-writer",
    "docx-writer"
  ],
  "type": "commonjs",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "model.d.ts",
    "wasm/*.js",
    "wasm/*.d.ts",
    "wasm/*.wasm",
    "fonts/*.ttf",
    "fonts/OFL-*.txt",
    "fonts/LICENSE-*.txt",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test/smoke.cjs"
  }
}
