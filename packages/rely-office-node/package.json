{
  "name": "@relybytes/rely-office",
  "version": "0.3.0",
  "description": "Office documents in Node and the browser through WebAssembly: format detection, text for search, sheet tables, the docx document tree, PDF and PNG rendering through Typst, docx writing and an editable spreadsheet with formulas.",
  "license": "MPL-2.0",
  "author": "RelyBytes Consulting (https://relybytes.com)",
  "homepage": "https://github.com/relybytes/rely-office#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/relybytes/rely-office.git",
    "directory": "packages/rely-office-node"
  },
  "bugs": {
    "url": "https://github.com/relybytes/rely-office/issues"
  },
  "keywords": [
    "docx",
    "xlsx",
    "pptx",
    "office",
    "text-extraction",
    "webassembly",
    "pdf",
    "typst",
    "spreadsheet",
    "formulas",
    "xlsx-writer",
    "docx-writer"
  ],
  "type": "commonjs",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./web": {
      "types": "./web/index.d.ts",
      "default": "./web/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "wasm/*.js",
    "wasm/*.d.ts",
    "wasm/*.wasm",
    "web/index.js",
    "web/index.d.ts",
    "web/package.json",
    "web/rely_office_sheet_wasm.js",
    "web/rely_office_sheet_wasm.d.ts",
    "web/rely_office_sheet_wasm_bg.wasm",
    "fonts/*.ttf",
    "fonts/OFL-*.txt",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test/smoke.cjs"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
