{
  "name": "@relybytes/rely-office",
  "version": "0.2.0",
  "description": "Reads office documents in Node through WebAssembly: format detection, text for search, sheet tables, a docx document tree for rich-text import, and PDF and PNG rendering through Typst.",
  "license": "MPL-2.0",
  "author": "RelyBytes Consulting (https://relybytes.com)",
  "homepage": "https://github.com/relybytes/rely-office#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/relybytes/rely-office.git",
    "directory": "packages/rely-office-node"
  },
  "bugs": {
    "url": "https://github.com/relybytes/rely-office/issues"
  },
  "keywords": [
    "docx",
    "xlsx",
    "pptx",
    "office",
    "text-extraction",
    "webassembly",
    "pdf",
    "typst"
  ],
  "type": "commonjs",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "wasm/rely_office_wasm.js",
    "wasm/rely_office_wasm.d.ts",
    "wasm/rely_office_wasm_bg.wasm",
    "wasm/rely_office_render_wasm.js",
    "wasm/rely_office_render_wasm.d.ts",
    "wasm/rely_office_render_wasm_bg.wasm",
    "fonts/*.ttf",
    "fonts/OFL-*.txt",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test/smoke.cjs"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
